<section id="art">
  <div class="section-head">
    <span class="section-mark">&sect; &mdash; the visual pile</span>
    <h2>Artwork</h2>
  </div>
  <p class="section-desc">Sketches, photos, whatever gets made with hands instead of words. Swipe or use the arrows.</p>

  <div class="carousel">
    <div class="carousel-track" id="artTrack"></div>
    <div class="carousel-controls">
      <button class="carousel-btn" id="artPrev" type="button" aria-label="Previous artwork">&larr;</button>
      <button class="carousel-btn" id="artNext" type="button" aria-label="Next artwork">&rarr;</button>
      <div class="carousel-dots" id="artDots"></div>
    </div>
  </div>
</section>
