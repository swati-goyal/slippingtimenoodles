---
const { mark = '02 — people, not labels', title = 'Portraits of People', intro = '', portraits = [] } = Astro.props;
---

<section id="portraits">
  <div class="section-head">
    <span class="section-mark">{mark}</span>
    <h2>{title}</h2>
  </div>
  <p class="section-desc">{intro}</p>

  <div class="portrait-list">
    {portraits.map((portrait) => (
      <article class="portrait">
        <p>{portrait.body}</p>
        <span class="portrait-note">portrait draft</span>
      </article>
    ))}
  </div>
</section>
