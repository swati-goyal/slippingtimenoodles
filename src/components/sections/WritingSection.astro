---
const { mark = '01 — not a sequence, just a number', title = 'Writing', intro = '', quoteLines = [], placeholderNote = '', links = [] } = Astro.props;
---

<section id="writing">
  <div class="section-head">
    <span class="section-mark">{mark}</span>
    <h2>{title}</h2>
  </div>
  <p class="section-desc">{intro}</p>

  <p class="poem">
    {quoteLines.length ? quoteLines.map((line) => <span>{line}</span>) : null}
  </p>
  <p class="placeholder-note">&uarr; {placeholderNote}</p>

  <div class="link-list">
    {links.map((link) => (
      <a class="link-pill" href={link.href || '#'}>{link.label}</a>
    ))}
  </div>
</section>
