---
const { mark = '02 — curiosity, credentialed', title = 'Engineering', intro = '', entries = [] } = Astro.props;
---

<section id="engineering">
  <div class="section-head">
    <span class="section-mark">{mark}</span>
    <h2>{title}</h2>
  </div>
  <p class="section-desc">{intro}</p>

  <div class="card">
    {entries.map((entry) => (
      <>
        <div class="cv-line">
          <span class="cv-role">{entry.role}</span>
          <span class="cv-meta">{entry.period}</span>
        </div>
        <div class="cv-line">
          <span class="cv-role">{entry.detail}</span>
          <span class="cv-meta">detail</span>
        </div>
      </>
    ))}
  </div>
</section>
