<section id="archive">
  <div class="section-head">
    <span class="section-mark">&sect; &mdash; the whole pile, searchable</span>
    <h2>Archive</h2>
  </div>
  <p class="section-desc">Every poem, essay, and stray note, hosted here in full &mdash; filter by kind or thread, or just search for the word you half-remember.</p>

  <input type="text" class="archive-search" id="archiveSearch" placeholder="search titles, tags, or text&hellip;" aria-label="Search archive">
  <div class="chip-row" id="typeChips" role="group" aria-label="Filter by type"></div>
  <div class="chip-row" id="tagChips" role="group" aria-label="Filter by tag"></div>
  <p class="archive-count" id="archiveCount"></p>
  <div id="entryList"></div>
</section>
