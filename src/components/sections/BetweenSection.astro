---
import Card from '../Card.astro';

const { mark = '— — everything in between', title = 'In Between', intro = "No folder for these. That's the point.", cards = [] } = Astro.props;
---

<section id="between">
  <div class="section-head">
    <span class="section-mark">{mark}</span>
    <h2>{title}</h2>
  </div>
  <p class="section-desc">{intro}</p>

  <div class="card-row">
    {cards.map((card) => (
      <Card><h3>{card.title}</h3><p>{card.body}</p></Card>
    ))}
  </div>
</section>
