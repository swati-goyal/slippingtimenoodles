---
const { eyebrow = 'a personal atlas / est. 2026', heroTitleLineOne = 'slipping time', heroTitleLineTwo = 'noodles.', heroSubtitle = 'A life doesn’t sort itself into folders.', scrollCue = 'keep pulling the thread' } = Astro.props;
---

<header class="hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="title">{heroTitleLineOne}<br><em>{heroTitleLineTwo}</em></h1>
  <p class="hero-sub">{heroSubtitle.split('aches').length > 1 ? heroSubtitle : heroSubtitle}</p>
  <span class="scroll-cue"><span class="bounce">&darr;</span> {scrollCue}</span>
</header>
