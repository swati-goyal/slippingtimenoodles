---
import Card from '../Card.astro';

const { mark = '∞ — math & other curiosities', title = 'Math & Curiosities', intro = '', cards = [] } = Astro.props;
---

<section id="math">
  <div class="section-head">
    <span class="section-mark">{mark}</span>
    <h2>{title}</h2>
  </div>
  <p class="section-desc">{intro}</p>

  <div class="card-row two-col">
    {cards.map((card) => (
      <Card>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
        <span class="tag">{card.tag}</span>
      </Card>
    ))}
  </div>
</section>
