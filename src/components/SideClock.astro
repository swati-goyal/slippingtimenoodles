<aside class="side-clock">
  <span class="label">local timekeeping</span>
  <div class="clock-shell">
    <div class="clock-face" id="sideClockFace" aria-label="25-hour clock showing the current local time on s7k2">
      <div class="hand hour" id="sideClockHour"></div>
      <div class="hand minute" id="sideClockMinute"></div>
      <div class="center-dot"></div>
    </div>
  </div>
  <div class="planet-time" id="sideClockTime">00:00</div>
  <div class="planet-year" id="sideClockYear">s7k2 · year 26</div>
  <div class="status" id="sideClockStatus" aria-live="polite">still orbiting</div>
</aside>
