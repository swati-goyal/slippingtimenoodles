<aside class="side-clock" aria-live="polite">
  <span class="label">local timekeeping</span>
  <div class="clock-shell">
    <div class="clock-face" id="sideClockFace" aria-label="500-day countdown clock, with 25 Earth hours in each local day">
      <div class="hand hour" id="sideClockHour"></div>
      <div class="hand minute" id="sideClockMinute"></div>
      <div class="center-dot"></div>
    </div>
  </div>
  <div class="planet-year" id="sideClockYear">planetary year 26</div>
  <div class="status" id="sideClockStatus">still orbiting</div>
</aside>
