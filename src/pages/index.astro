---
import '../styles/site.css';
import Card from '../components/Card.astro';
import Footer from '../components/Footer.astro';
import SideClock from '../components/SideClock.astro';
import Hero from '../components/sections/Hero.astro';
import WritingSection from '../components/sections/WritingSection.astro';
import PortraitsSection from '../components/sections/PortraitsSection.astro';
import ArchiveSection from '../components/sections/ArchiveSection.astro';
import MathSection from '../components/sections/MathSection.astro';
import EngineeringSection from '../components/sections/EngineeringSection.astro';
import BetweenSection from '../components/sections/BetweenSection.astro';
import ArtworkSection from '../components/sections/ArtworkSection.astro';
import { getArchiveEntries, getArtwork, getHomePage } from '../lib/sanity';

const defaultHomePage = {
  eyebrow: 'a personal atlas / est. 2026',
  heroTitleLineOne: 'slipping time',
  heroTitleLineTwo: 'noodles.',
  heroSubtitle:
    "A life doesn't sort itself into folders. Mine loops — a proof aches like a poem, a poem behaves like an engineering problem, and Tuesday keeps looping back through 1998. This is where the noodle goes when it slips.",
  scrollCue: 'keep pulling the thread',
  writingTitle: 'Writing',
  writingMark: '01 — not a sequence, just a number',
  writingIntro:
    "Poems, essays, and the feminist pieces that wouldn't stay quiet. Some of it signs its real name. Some of it hides as Knightess.",
  writingQuote: [
    '[ a placeholder verse — swap this for a real fragment ]',
    'the noodle does not know it is a noodle',
    'it only knows it is slipping, and calls that living',
  ],
  writingPlaceholderNote: 'drop in three lines of your own here. this is a stand-in, not your voice.',
  writingLinks: [
    { label: 'Medium — under my own name', href: '#' },
    { label: 'Medium — as Knightess', href: '#' },
    { label: 'Tumblr — bhasad', href: '#' },
    { label: 'the full archive', href: '#archive' },
  ],
  portraitTitle: 'Portraits of People',
  portraitMark: '02 — people, not labels',
  portraitIntro:
    'A place to keep written portraits of the people in my life, without names or judgments. I want to notice how I remember them, what was actually interesting, and what was only a passing observation.',
  portraits: [
    {
      body:
        'A person who moves through a room as though they are listening for the shape of it before they enter it. They are graceful without trying to be, and their attention lands on a person as if it has already decided to stay.',
    },
    {
      body:
        'Someone whose warmth is easy to mistake for certainty, though it is really a soft kind of courage. They make conversation feel larger than it is, and leave behind a sense that other people are allowed to be vivid too.',
    },
    {
      body:
        'A quick observation that lingered longer than it should have: the kind of person who keeps their feeling hidden in the posture of the body, in the pause before speaking, in the way they notice everything and call it ordinary.',
    },
  ],
  archiveTitle: 'Archive',
  archiveMark: '§ — the whole pile, searchable',
  archiveIntro:
    'Every poem, essay, and stray note, hosted here in full — filter by kind or thread, or just search for the word you half-remember.',
  mathTitle: 'Math & Curiosities',
  mathMark: '∞ — math & other curiosities',
  mathIntro:
    'Half-finished proofs, things I find beautiful, and the slow work of a mathematician-in-training. Not a lecture. A sketchbook.',
  mathCards: [
    {
      title: 'Mathematics for Poets',
      body: 'A big mathematical idea, opened with a poem that already knew it. Quarterly, unhurried, in progress.',
      tag: 'ongoing — current focus',
    },
    {
      title: 'Reading log',
      body: "Notes from Wolf's Proof, Logic, and Conjecture, and whatever comes after it, in the years before Hagen.",
      tag: 'rebuilding — 2026–2029',
    },
  ],
  engineeringTitle: 'Engineering',
  engineeringMark: '02 — curiosity, credentialed',
  engineeringIntro:
    'The part of the site that looks the most like a CV, framed the way it actually feels: as curiosity that happens to pay rent.',
  engineeringEntries: [
    {
      role: 'SDET — Orbem, Munich',
      period: '2025 – present',
      detail: 'Testing infrastructure for research & ML systems, MRI-adjacent',
    },
    {
      role: 'Currently deepening AI / CS engineering skills',
      period: 'current focus',
      detail: 'Testing infrastructure for research & ML systems, MRI-adjacent',
    },
  ],
  betweenTitle: 'In Between',
  betweenMark: '— — everything in between',
  betweenIntro: "No folder for these. That's the point.",
  betweenCards: [
    { title: 'Astrophotography', body: 'A rig, a budget, and a lot of patient waiting for clear sky.' },
    { title: 'Lindy hop', body: 'Boogie Bären, still on Level 1, still delighted by it.' },
    { title: 'German, A1.2', body: 'The current gate to almost everything else on this list.' },
    { title: 'Puzzles & folklore', body: 'Jigsaw pieces, selkies, and the odd corner of mythology.' },
  ],
  footerTitle: 'say hello, or don’t — the noodle keeps slipping either way.',
  footerLine: 'slippingtimenoodles.com · built to loop, not to finish',
};

const homePage = await getHomePage() ?? defaultHomePage;
const archiveEntries = await getArchiveEntries();

const cmsArtwork = await getArtwork();
const artwork = cmsArtwork.length ? cmsArtwork : [
  { title: '[placeholder] untitled sketch', year: '2026', src: '', caption: 'graphite \u2014 swap src for a real photo of this' },
  { title: '[placeholder] noodle study', year: '2026', src: '', caption: 'ink \u2014 swap src for a real photo of this' },
  { title: '[placeholder] a stray doodle', year: '2026', src: '', caption: 'pencil \u2014 swap src for a real photo of this' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>slipping time noodles</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Literata:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

<SideClock />

<div class="wrap">
  <Hero
    eyebrow={homePage.eyebrow}
    heroTitleLineOne={homePage.heroTitleLineOne}
    heroTitleLineTwo={homePage.heroTitleLineTwo}
    heroSubtitle={homePage.heroSubtitle}
    scrollCue={homePage.scrollCue}
  />
  <WritingSection
    mark={homePage.writingMark}
    title={homePage.writingTitle}
    intro={homePage.writingIntro}
    quoteLines={homePage.writingQuote || defaultHomePage.writingQuote}
    placeholderNote={homePage.writingPlaceholderNote || defaultHomePage.writingPlaceholderNote}
    links={homePage.writingLinks || defaultHomePage.writingLinks}
  />
  <PortraitsSection
    mark={homePage.portraitMark}
    title={homePage.portraitTitle}
    intro={homePage.portraitIntro}
    portraits={homePage.portraits || defaultHomePage.portraits}
  />
  <ArchiveSection
    mark={homePage.archiveMark}
    title={homePage.archiveTitle}
    intro={homePage.archiveIntro}
  />
  <MathSection
    mark={homePage.mathMark}
    title={homePage.mathTitle}
    intro={homePage.mathIntro}
    cards={homePage.mathCards || defaultHomePage.mathCards}
  />
  <EngineeringSection
    mark={homePage.engineeringMark}
    title={homePage.engineeringTitle}
    intro={homePage.engineeringIntro}
    entries={homePage.engineeringEntries || defaultHomePage.engineeringEntries}
  />
  <BetweenSection
    mark={homePage.betweenMark}
    title={homePage.betweenTitle}
    intro={homePage.betweenIntro}
    cards={homePage.betweenCards || defaultHomePage.betweenCards}
  />
  <ArtworkSection />
  <Footer title={homePage.footerTitle || defaultHomePage.footerTitle} line={homePage.footerLine || defaultHomePage.footerLine} />
</div>

<script define:vars={{ archiveEntries }}>
  (function init500DayClock(){
    var earthHoursPerPlanetaryDay = 25;
    var cycleMs = 500 * earthHoursPerPlanetaryDay * 60 * 60 * 1000;
    var sharedStartMs = Date.parse('2026-09-16T00:00:00Z');
    var sentCycleKey = 'slipping-time-noodles-email-sent-cycle';
    var emailAddress = 'hello@slippingtimenoodles.com';
    var hourEl = document.getElementById('sideClockHour');
    var minuteEl = document.getElementById('sideClockMinute');
    var yearEl = document.getElementById('sideClockYear');
    var statusEl = document.getElementById('sideClockStatus');
    var faceEl = document.getElementById('sideClockFace');
    if (!hourEl || !minuteEl || !yearEl || !statusEl || !faceEl) return;

    function composeMailto(){
      var subject = encodeURIComponent('500 days complete — congratulations');
      var body = encodeURIComponent(
        'Congratulations on finishing another 500 days on this spinning planet whose speed I can not feel.\n\nI hope this next orbit feels a little more alive, a little more honest, and a little less like a loop.\n\n— the time noodle'
      );
      return 'mailto:' + emailAddress + '?subject=' + subject + '&body=' + body;
    }

    function buildFaceMarks(){
      for (var i = 0; i < 12; i += 1){
        var mark = document.createElement('span');
        mark.className = 'face-mark' + (i % 3 === 0 ? ' major' : '');
        var angle = (i / 12) * 360;
        mark.style.transform = 'translate(-50%, -50%) rotate(' + angle + 'deg) translateY(-42px)';
        faceEl.appendChild(mark);
      }
    }

    function updateClock(){
      var elapsedSinceSharedStart = Date.now() - sharedStartMs;
      var cycleNumber = Math.max(0, Math.floor(elapsedSinceSharedStart / cycleMs));
      var lastCycleStart = sharedStartMs + cycleNumber * cycleMs;
      var elapsed = Date.now() - lastCycleStart;
      var remaining = Math.max(0, cycleMs - elapsed);
      var progress = Math.min(Math.max((cycleMs - remaining) / cycleMs, 0), 1);
      var angle = progress * 360;
      yearEl.textContent = 'planetary year ' + String(cycleNumber + 1).padStart(2, '0');

      hourEl.style.transform = 'translate(-50%, -100%) rotate(' + angle + 'deg)';
      minuteEl.style.transform = 'translate(-50%, -100%) rotate(' + (angle * 2) + 'deg)';

      if (remaining <= 0){
        statusEl.textContent = '500 complete';
        var mailto = composeMailto();
        var hasSent = localStorage.getItem(sentCycleKey) === String(cycleNumber);
        if (!hasSent){
          localStorage.setItem(sentCycleKey, String(cycleNumber));
          window.location.href = mailto;
        }
        return;
      }

      var daysLeft = Math.ceil(remaining / (earthHoursPerPlanetaryDay * 60 * 60 * 1000));
      statusEl.textContent = daysLeft === 1 ? '1 day left' : daysLeft + ' days left';
    }

    buildFaceMarks();
    updateClock();
    setInterval(updateClock, 1000 * 60);
  })();

  var ENTRIES = archiveEntries && archiveEntries.length ? archiveEntries : [
    {
      id: 'e1', title: '[placeholder] on forgetting slowly', type: 'poem', identity: 'self',
      date: '2026', tags: ['love', 'distance'],
      body: 'a placeholder stanza\nswap this for your real poem\nkeep the ache, lose the name'
    },
    {
      id: 'e2', title: '[placeholder] a pretty man, said on purpose', type: 'poem', identity: 'knightess',
      date: '2026', tags: ['gender', 'inversion'],
      body: 'another placeholder stanza\nyou know how this line should go\nbetter than I do'
    },
    {
      id: 'e3', title: '[placeholder] why we test what we build', type: 'essay', identity: 'self',
      date: '2026', tags: ['engineering', 'philosophy'],
      body: 'A placeholder essay opening. Replace with your real paragraphs \u2014 this is just holding the shape and the formatting.'
    },
    {
      id: 'e4', title: '[placeholder] reading notes \u2014 Wolf, ch.1', type: 'note', identity: 'self',
      date: '2026', tags: ['math', 'proof'],
      body: 'Placeholder reading notes. Swap for your actual annotations from Proof, Logic, and Conjecture.'
    },
    {
      id: 'e5', title: '[placeholder] a shape for testing infrastructure', type: 'note', identity: 'self',
      date: '2026', tags: ['engineering', 'work'],
      body: 'Placeholder work note. Replace with something real from your notebook.'
    }
  ];

  (function initArchive(){
    var typeChipsEl = document.getElementById('typeChips');
    var tagChipsEl = document.getElementById('tagChips');
    var searchEl = document.getElementById('archiveSearch');
    var listEl = document.getElementById('entryList');
    var countEl = document.getElementById('archiveCount');
    if (!listEl) return;

    var activeType = 'all';
    var activeTags = {};

    function el(tag, cls, text){
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    }

    var types = ['all'].concat(ENTRIES.map(function(e){ return e.type; })
      .filter(function(t, i, arr){ return arr.indexOf(t) === i; }));

    var allTags = ENTRIES.reduce(function(acc, e){ return acc.concat(e.tags); }, [])
      .filter(function(t, i, arr){ return arr.indexOf(t) === i; })
      .sort();

    types.forEach(function(t){
      var chip = el('button', 'chip' + (t === 'all' ? ' active' : ''), t);
      chip.type = 'button';
      chip.addEventListener('click', function(){
        activeType = t;
        Array.prototype.forEach.call(typeChipsEl.children, function(c){ c.classList.remove('active'); });
        chip.classList.add('active');
        render();
      });
      typeChipsEl.appendChild(chip);
    });

    allTags.forEach(function(tag){
      var chip = el('button', 'chip', '#' + tag);
      chip.type = 'button';
      chip.addEventListener('click', function(){
        if (activeTags[tag]) { delete activeTags[tag]; chip.classList.remove('active'); }
        else { activeTags[tag] = true; chip.classList.add('active'); }
        render();
      });
      tagChipsEl.appendChild(chip);
    });

    searchEl.addEventListener('input', render);

    function matches(entry){
      if (activeType !== 'all' && entry.type !== activeType) return false;
      var neededTags = Object.keys(activeTags);
      if (neededTags.length > 0){
        var hasAll = neededTags.every(function(t){ return entry.tags.indexOf(t) !== -1; });
        if (!hasAll) return false;
      }
      var q = searchEl.value.trim().toLowerCase();
      if (q){
        var hay = (entry.title + ' ' + entry.tags.join(' ') + ' ' + entry.body).toLowerCase();
        if (hay.indexOf(q) === -1) return false;
      }
      return true;
    }

    function render(){
      listEl.innerHTML = '';
      var results = ENTRIES.filter(matches);
      countEl.textContent = results.length + (results.length === 1 ? ' entry' : ' entries');

      if (results.length === 0){
        listEl.appendChild(el('p', 'no-results', 'nothing matches yet \u2014 try clearing a filter.'));
        return;
      }

      results.forEach(function(entry){
        var details = el('details', 'entry');
        var summary = document.createElement('summary');

        var title = el('span', 'entry-title', entry.title);
        var meta = el('span', 'entry-meta');
        var typeSpan = el('span', 'entry-type ' + entry.type, entry.type);
        meta.appendChild(typeSpan);
        meta.appendChild(document.createTextNode(' \u00b7 ' + entry.date + ' \u00b7 ' + (entry.identity === 'knightess' ? 'as Knightess' : 'self')));

        summary.appendChild(title);
        summary.appendChild(meta);

        var body = el('div', 'entry-body' + (entry.type === 'poem' ? ' is-poem' : ''), entry.body);

        var tagsRow = el('div', 'entry-tags');
        entry.tags.forEach(function(t){ tagsRow.appendChild(el('span', 'entry-tag', '#' + t)); });

        details.appendChild(summary);
        details.appendChild(body);
        details.appendChild(tagsRow);
        listEl.appendChild(details);
      });
    }

    render();
  })();

  var ART = artwork;

  (function initCarousel(){
    var track = document.getElementById('artTrack');
    var dotsEl = document.getElementById('artDots');
    var prevBtn = document.getElementById('artPrev');
    var nextBtn = document.getElementById('artNext');
    if (!track) return;

    ART.forEach(function(art, i){
      var slide = document.createElement('div');
      slide.className = 'carousel-slide';
      slide.id = 'artSlide-' + i;

      var frame = document.createElement('div');
      frame.className = 'art-frame';
      if (art.src){
        var img = document.createElement('img');
        img.src = art.src;
        img.alt = art.title;
        frame.appendChild(img);
      } else {
        var ph = document.createElement('div');
        ph.className = 'art-placeholder';
        ph.textContent = '[ image placeholder \u2014 add a src ]';
        frame.appendChild(ph);
      }

      var title = document.createElement('p');
      title.className = 'art-title';
      title.textContent = art.title;

      var caption = document.createElement('p');
      caption.className = 'art-caption';
      caption.textContent = art.year + ' \u00b7 ' + art.caption;

      slide.appendChild(frame);
      slide.appendChild(title);
      slide.appendChild(caption);
      track.appendChild(slide);

      var dot = document.createElement('button');
      dot.className = 'dot' + (i === 0 ? ' active' : '');
      dot.type = 'button';
      dot.setAttribute('aria-label', 'Go to artwork ' + (i + 1));
      dot.addEventListener('click', function(){
        slide.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      });
      dotsEl.appendChild(dot);
    });

    var dots = Array.prototype.slice.call(dotsEl.children);

    function setActiveDot(i){
      dots.forEach(function(d, j){ d.classList.toggle('active', j === i); });
    }

    if ('IntersectionObserver' in window){
      var observer = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if (entry.isIntersecting){
            var idx = Array.prototype.indexOf.call(track.children, entry.target);
            setActiveDot(idx);
          }
        });
      }, { root: track, threshold: 0.6 });
      Array.prototype.forEach.call(track.children, function(slide){ observer.observe(slide); });
    }

    function scrollByOne(dir){
      var slideEl = track.children[0];
      var gap = 20;
      var amount = (slideEl ? slideEl.getBoundingClientRect().width : 300) + gap;
      track.scrollBy({ left: dir * amount, behavior: 'smooth' });
    }
    prevBtn.addEventListener('click', function(){ scrollByOne(-1); });
    nextBtn.addEventListener('click', function(){ scrollByOne(1); });
  })();
</script>

</body>
</html>
