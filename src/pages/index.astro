---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import { defaultHomePage, pages } from '../lib/content';
import { getHomePage } from '../lib/sanity';

const homePage = (await getHomePage()) ?? defaultHomePage;
---
<Layout footerTitle={homePage.footerTitle} footerLine={homePage.footerLine}>
  <Hero
    eyebrow={homePage.eyebrow}
    heroTitleLineOne={homePage.heroTitleLineOne}
    heroTitleLineTwo={homePage.heroTitleLineTwo}
    heroSubtitle={homePage.heroSubtitle}
    scrollCue={homePage.scrollCue}
  />

  <section id="index">
    <div class="section-head">
      <span class="section-mark">&sect; &mdash; where the thread goes</span>
      <h2>Pull one</h2>
    </div>
    <ul class="page-index">
      {pages.map((page) => (
        <li>
          <a href={page.href}>
            <span class="index-label">{page.label}</span>
            <span class="index-blurb">{page.blurb}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
