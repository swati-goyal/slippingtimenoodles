---
import '../styles/site.css';
import SideClock from '../components/SideClock.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { defaultHomePage } from '../lib/content';

const { title, footerTitle, footerLine } = Astro.props;
const pageTitle = title ? `${title} · slipping time noodles` : 'slipping time noodles';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{pageTitle}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Literata:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

<SideClock />

<div class="wrap">
  <Nav />
  <slot />
  <Footer
    title={footerTitle || defaultHomePage.footerTitle}
    line={footerLine || defaultHomePage.footerLine}
  />
</div>

<script>
  (function initPlanetaryClock(){
    var planetName = 's7k2';
    var planetaryYearDays = 480;
    var earthHoursPerPlanetaryDay = 25;
    var planetaryDayMs = earthHoursPerPlanetaryDay * 60 * 60 * 1000;
    var cycleMs = planetaryYearDays * planetaryDayMs;
    // The local year turns on day 479, two days before the cycle itself ends.
    var markDay = planetaryYearDays - 1;
    var sharedStartMs = Date.parse('1988-08-19T02:00:00Z');
    var hourEl = document.getElementById('sideClockHour');
    var minuteEl = document.getElementById('sideClockMinute');
    var timeEl = document.getElementById('sideClockTime');
    var yearEl = document.getElementById('sideClockYear');
    var statusEl = document.getElementById('sideClockStatus');
    var faceEl = document.getElementById('sideClockFace');
    if (!hourEl || !minuteEl || !timeEl || !yearEl || !statusEl || !faceEl) return;

    function buildFaceMarks(){
      for (var i = 0; i < earthHoursPerPlanetaryDay; i += 1){
        var mark = document.createElement('span');
        mark.className = 'face-mark' + (i % 5 === 0 ? ' major' : '');
        var angle = (i / earthHoursPerPlanetaryDay) * 360;
        mark.style.transform = 'translate(-50%, -50%) rotate(' + angle + 'deg) translateY(-42px)';
        faceEl.appendChild(mark);
      }
    }

    function updateClock(){
      var elapsedSinceSharedStart = Date.now() - sharedStartMs;
      var cycleNumber = Math.max(0, Math.floor(elapsedSinceSharedStart / cycleMs));
      var lastCycleStart = sharedStartMs + cycleNumber * cycleMs;
      var elapsed = Date.now() - lastCycleStart;
      var planetaryDay = Math.min(planetaryYearDays, Math.floor(elapsed / planetaryDayMs) + 1);

      yearEl.textContent = planetName + ' · year ' + (cycleNumber - 1 + (planetaryDay >= markDay ? 1 : 0));

      // A local hour is one Earth hour, so a local day is 25 of them and the dial
      // carries 25 marks. The hour hand turns once per local day, not twice.
      var msIntoDay = elapsed % planetaryDayMs;
      var msIntoHour = msIntoDay % 3600000;
      var localHour = Math.floor(msIntoDay / 3600000);
      var localMinute = Math.floor(msIntoHour / 60000);
      timeEl.textContent = String(localHour).padStart(2, '0') + ':' + String(localMinute).padStart(2, '0');

      hourEl.style.transform = 'translate(-50%, -100%) rotate(' + ((msIntoDay / planetaryDayMs) * 360) + 'deg)';
      minuteEl.style.transform = 'translate(-50%, -100%) rotate(' + ((msIntoHour / 3600000) * 360) + 'deg)';

      // Day 480 sits past the mark, so it wraps to the mark in the next cycle.
      var daysLeft = markDay - planetaryDay;
      if (daysLeft < 0) daysLeft += planetaryYearDays;

      if (daysLeft === 0){
        statusEl.textContent = 'happy birthday';
        return;
      }

      statusEl.textContent = daysLeft === 1 ? '1 day left' : daysLeft + ' days left';
    }

    buildFaceMarks();
    updateClock();
    setInterval(updateClock, 1000);
  })();
</script>

</body>
</html>
